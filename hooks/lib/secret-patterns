# secret-patterns — regexes (PCRE) compartidas por no-secret-leak.sh.
# Se usa con `source`; `find_secret "$contenido" [providers-only]` imprime la etiqueta del primer acierto y devuelve 0, o devuelve 1.

SECRET_LABELS=("AWS Access Key ID" "GitHub token" "Anthropic/OpenAI API key" "GitHub fine-grained token" "Slack token" "private key block" "potential API key/secret" "database connection string with credentials")
SECRET_REGEXES=(
  'AKIA[0-9A-Z]{16}'
  'gh[ps]_[a-zA-Z0-9]{36}'
  'sk-(ant|proj)-[A-Za-z0-9_-]{20,}|\bsk-[A-Za-z0-9]{40,}'
  'github_pat_[A-Za-z0-9_]{22,}'
  'xox[baprs]-[A-Za-z0-9-]{10,}'
  '-----BEGIN\s+\S*\s*PRIVATE KEY-----'
  '(?i)(api_key|secret_key|auth_token|access_token)\s*[=:]\s*[a-zA-Z0-9+/]{20,}'
  '(postgresql|mysql|mongodb|redis)://[^:@\s]+:[^@\s]+@'
)

# Índices de los patrones genéricos (se saltan en tests, fixtures y ejemplos).
SECRET_GENERIC_IDX=(6 7)

find_secret() {
  local i g
  for i in "${!SECRET_REGEXES[@]}"; do
    if [[ "${2:-}" == providers-only ]]; then
      for g in "${SECRET_GENERIC_IDX[@]}"; do [[ $g == "$i" ]] && continue 2; done
    fi
    if grep -qP -e "${SECRET_REGEXES[$i]}" <<<"$1"; then
      echo "${SECRET_LABELS[$i]}"; return 0
    fi
  done
  return 1
}
